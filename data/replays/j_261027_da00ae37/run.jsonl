_d\"] / 2)\n+        body = body.union(studs.extrude(p[\"boss_h\"] + 0.2))\n+    return body\n","hausdorff_mm":0.23331862342096513,"iou":0.9958151700087184,"passed_tests":8,"total_tests":8}
