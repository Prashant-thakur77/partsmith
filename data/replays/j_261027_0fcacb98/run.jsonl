{"job":"j_261027_0fcacb98","seq":110,"ts":1793109627.6698396,"ctx":"404d31103bbf5887","t":"iteration","iter":6,"strategy":"free_code","edits":[],"analysis":"strategy switch: free code from the measured outline","code_sha":"4c8e4326cabd4a707825a015885903be0d3b69971f55d57a60e087573c5c1c84","diff":"--- before.py\n+++ after.py\n@@ -1,3 +1 @@\n-# part.py — generated by PartSmith from the battery_cover template (deterministic mock builder).\n-\"\"\"Battery compartment cover (remote control, toy, clock): thin door with hinge tongues and a snap latch.\"\"\"\n-\n+# part.py — generated by PartSmith (free-code strategy, deterministic mock builder). Edit PARAMS only.\n@@ -6,8 +4,6 @@\n-FAMILY = \"cover\"\n-TITLE = \"Battery compartment cover\"\n-SUMMARY = (\n-    \"Thin sliding/tilting battery door: tongues at one end tuck under the case lip, a cantilever snap latch at the \"\n-    \"other end clicks into the case. Grip grooves on the outer face.\"\n-)\n-TAGS = [\"battery cover\", \"battery door\", \"remote control\", \"toy\", \"lid\", \"snap-fit\"]\n-MEASURE_MAP = {\"length\": \"length\", \"width\": \"width\", \"thickness\": \"thickness\"}\n+FAMILY = 'cover'\n+OUTLINE = [(-15.949, 11.765), (-15.902, -11.804), (-14.649, -12.034), (15.689, -12.001), (15.991, -11.76), (15.95, 7.857), (11.959, 11.974), (-15.486, 12.009)]\n+HOLES = []\n+SLOTS = []\n+BOSSES = []\n+MEASURE_MAP = {'thickness': 'thickness', 'side.thickness': 'thickness'}\n@@ -16,11 +12,2 @@\n-    \"length\": (32.0, 26.0, 100.0, 0.1, \"mm\", True, \"Overall length including tongues\"),\n-    \"width\": (24.0, 16.0, 60.0, 0.1, \"mm\", True, \"Width\"),\n-    \"thickness\": (2.0, 1.0, 3.0, 0.05, \"mm\", True, \"Door thickness\"),\n-    \"tongue_length\": (3.0, 1.5, 6.0, 0.1, \"mm\", True, \"Tongue length\"),\n-    \"tongue_width\": (6.0, 3.0, 12.0, 0.1, \"mm\", True, \"Tongue width\"),\n-    \"tongue_count\": (2, 1, 3, 1, \"\", True, \"Hinge tongues\"),\n-    \"latch_width\": (10.0, 4.0, 30.0, 0.1, \"mm\", True, \"Latch width\"),\n-    \"latch_height\": (3.5, 2.0, 8.0, 0.1, \"mm\", True, \"Latch height above the inner face\"),\n-    \"latch_overhang\": (0.8, 0.4, 2.0, 0.05, \"mm\", True, \"Latch hook overhang\"),\n-    \"groove_count\": (5, 0, 12, 1, \"\", False, \"Grip grooves (outer face)\"),\n-    \"corner_radius\": (1.4, 0.0, 8.0, 0.1, \"mm\", False, \"Corner radius\"),\n+    \"thickness\": (2.1, 0.80, 40.0, 0.01, \"mm\", True, \"Plate thickness\"),\n+    \"outline_offset\": (0.0, -1.0, 1.0, 0.02, \"mm\", True, \"Outline offset (+ grows the outline)\"),\n@@ -30,45 +17,18 @@\n-def build(p: dict[str, float]) -> cq.Workplane:\n-    length, width, t = p[\"length\"], p[\"width\"], p[\"thickness\"]\n-    tl = p[\"tongue_length\"]\n-    plate_len = length - tl\n-    x0 = -length / 2 + tl  # where the door plate starts; tongues stick out beyond it\n-\n-    plate = cq.Workplane(\"XY\").center(x0 + plate_len / 2, 0).rect(plate_len, width).extrude(t)\n-    r = min(p[\"corner_radius\"], width / 2 - 0.5, plate_len / 4)\n-    if r > 0.2:\n-        plate = plate.edges(\"|Z and >X\").fillet(r)\n-        r_back = min(r, 1.0)\n-        if r_back > 0.2:\n-            plate = plate.edges(\"|Z and <X\").fillet(r_back)\n-\n-    # Grip grooves across the outer face (z = 0), keeping >= 0.9 mm of material.\n-    g = int(p[\"groove_count\"])\n-    gd = min(0.5, t - 0.9)\n-    if g > 0 and gd > 0.1:\n-        xs = [(i - (g - 1) / 2) * 2.0 + x0 + plate_len * 0.35 for i in range(g)]\n-        cut = cq.Workplane(\"XY\").workplane(offset=-1).pushPoints([(x, 0) for x in xs]).rect(1.0, width * 0.6)\n-        plate = plate.cut(cut.extrude(1 + gd))\n-\n-    # Tongues, a little thinner than the door.\n-    n = int(p[\"tongue_count\"])\n-    tt = max(0.8, min(t, t * 0.75))\n-    tw = min(p[\"tongue_width\"], (width - 2.0) / n - 1.0)\n-    pitch = (width - 2.0) / n\n-    for i in range(n):\n-        y = -width / 2 + 1.0 + pitch * (i + 0.5)\n-        tongue = cq.Workplane(\"XY\").box(tl + 0.5, tw, tt, centered=(False, True, False)).translate((-length / 2, y, 0))\n-        plate = plate.union(tongue)\n-\n-    # Snap latch on the inner face (+Z) at the far end, hook pointing outwards (+X).\n-    lw = min(p[\"latch_width\"], width - 4.0)\n-    lh = p[\"latch_height\"]\n-    lip = p[\"latch_overhang\"]\n-    la = max(1.0, t * 0.8)\n-    x_out = length / 2 - 1.0 - lip  # outer face of the latch arm\n-    z_top = t + lh\n-    arm = cq.Workplane(\"XY\").box(la, lw, lh + 0.2, centered=(False, True, False)).translate((x_out - la, 0, t - 0.2))\n-    lip_h = min(max(lip * 1.5 + 0.6, 1.2), lh - 0.6)\n-    z0 = z_top - lip_h\n-    prof = [(x_out - 0.2, z0), (x_out + lip, z0), (x_out + lip, z0 + max(0.9, lip_h * 0.4)), (x_out - 0.2, z_top)]\n-    hook = cq.Workplane(\"XZ\").polyline(prof).close().extrude(lw / 2, both=True)\n-    return plate.union(arm).union(hook)\n+def build(p):\n+    t = p[\"thickness\"]\n+    prof = cq.Workplane(\"XY\").polyline(OUTLINE).close()\n+    if abs(p[\"outline_offset\"]) > 0.005:\n+        prof = prof.offset2D(p[\"outline_offset\"], \"intersection\")\n+    body = prof.extrude(t)\n+    for i, c in enumerate(HOLES):\n+        d = p[\"hole_\" + str(i + 1) + \"_d\"]\n+        cutter = cq.Workplane(\"XY\").workplane(offset=-1).center(c[0], c[1]).circle(d / 2).extrude(t + 2)\n+        body = body.cut(cutter)\n+    for i, s in enumerate(SLOTS):\n+        sl, sw = p[\"slot_\" + str(i + 1) + \"_l\"], p[\"slot_\" + str(i + 1) + \"_w\"]\n+        cutter = cq.Workplane(\"XY\").workplane(offset=-1).center(s[0], s[1]).slot2D(sl, sw, s[2]).extrude(t + 2)\n+        body = body.cut(cutter)\n+    if BOSSES:\n+        studs = cq.Workplane(\"XY\").workplane(offset=t - 0.2).pushPoints(BOSSES).circle(p[\"boss_d\"] / 2)\n+        body = body.union(studs.extrude(p[\"boss_h\"] + 0.2))\n+    return body\n","hausdorff_mm":1.0130568799659052,"iou":0.9635011828320379,"passed_tests":9,"total_tests":9}
