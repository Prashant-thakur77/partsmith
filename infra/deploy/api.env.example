# PartSmith API — environment for a PUBLIC deploy (Docker on a VM, or Modal). Copy it OUTSIDE the repo and
# fill in the lines marked REQUIRED. `make deploy-check` validates this template.
#
# The public default spends nothing: no model keys, PROVIDER_MODE=replay. Recorded calls are served from
# $PARTSMITH_HOME/recordings; anything not recorded runs as a labelled deterministic mock. The committed replays
# (data/replays), demo samples and bench reports are part of the image.

# --- REQUIRED --------------------------------------------------------------------------------------------------------
# Locks publishing, the factory, lessons, request status and print-shop batches. The container refuses to start
# without it. Generate: openssl rand -hex 24
PARTSMITH_ADMIN_TOKEN=
# replay | mock. Use live only with the owner's go-ahead (it spends credits) and the keys below.
PROVIDER_MODE=replay
# The web origin(s) allowed by CORS (comma-separated). The browser normally calls the web origin, which proxies
# /api/v1, so this matters only for direct API use from other sites.
PARTSMITH_CORS_ORIGINS=https://partsmith.example.vercel.app
# Base for absolute links in llms.txt/prompt.txt when no X-Forwarded-Host is sent. Use the web URL: it proxies
# /api/v1 and /mcp, so every public link stays on one origin.
PARTSMITH_PUBLIC_URL=https://partsmith.example.vercel.app
# Public URL of the web app (share links, QR codes, MCP part links).
PARTSMITH_WEB_URL=https://partsmith.example.vercel.app
# Host names (no scheme) allowed to reach the MCP endpoint at /mcp, comma-separated: the API host and the web host.
PARTSMITH_MCP_ALLOWED_HOSTS=api.partsmith.example,partsmith.example.vercel.app

# --- Runtime (defaults are fine) -------------------------------------------------------------------------------------
# Writable data: SQLite registry, blobs, bakes, jobs, recordings. Mount a persistent volume here.
PARTSMITH_HOME=/data
# Build the demo parts from the committed synthetic samples on first boot (skipped when the registry has parts).
PARTSMITH_SEED_ON_START=1
# Writes (POST/PUT/PATCH/DELETE) per IP per minute.
PARTSMITH_RATE_LIMIT=60
# Warm CAD worker processes (each ~300 MB). 1 fits a 2 GB machine; 2 for 4 GB+.
PARTSMITH_GEOM_WORKERS=1
PARTSMITH_WARM_CAD=1
# Leave empty to let the sandbox pick the strongest isolation the host allows.
PARTSMITH_SANDBOX_MODE=
# Salt for the anonymous usage counter (random and kept under PARTSMITH_HOME when empty).
PARTSMITH_USAGE_SALT=
# 1 = the MCP endpoint exposes read-only tools only.
PARTSMITH_MCP_READ_ONLY=1
PARTSMITH_SSE_HEARTBEAT_S=15
PARTSMITH_PRICE_PER_G_INR=3
PARTSMITH_PRICE_BASE_INR=0
# Extra .env file for provider settings (empty = none in the image; the environment always wins).
PARTSMITH_ENV_FILE=
# Which proxy addresses uvicorn trusts for X-Forwarded-For (the rate limit is per client IP).
FORWARDED_ALLOW_IPS=*
# Optional managed storage (default: SQLite + local disk under PARTSMITH_HOME). Needs the image built with
# UV_EXTRAS="--extra sam --extra storage".
DATABASE_URL=

# --- Model keys: leave EMPTY for the public replay/mock deploy ----------------------------------------------------
PROVIDER_RECORD=
PROVIDER_FALLBACK_TO_MOCK=1
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT_S=180
OPEN_WEIGHTS_ONLY=
MODEL_API_KEY=
META_API_KEY=
BASETEN_API_KEY=
SPARK_OPEN_MODEL=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
SAM3_OPEN_URL=
SAM3_OPEN_API_KEY=
# Optional: 0 skips the search-grounded "buy the original" lookup on the buy-or-print card (the print side stays).
PARTSMITH_BUY_LOOKUP=
