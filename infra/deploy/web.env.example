# PartSmith web (Next.js, Vercel project root: apps/web). Set these in the Vercel project settings
# (Production + Preview). `make deploy-check` validates this template.

# REQUIRED. Origin of the PartSmith API, no trailing slash and no /api/v1. The browser only talks to the web origin:
# /api/v1/*, /mcp and the SSE stream are proxied to this URL by the web app, so the API needs no CORS for the site.
# (API_URL is read first when both are set.)
NEXT_PUBLIC_API_URL=https://api.partsmith.example
# REQUIRED. The public URL of this site (canonical links, og:image, llms.txt).
NEXT_PUBLIC_SITE_URL=https://partsmith.example.vercel.app
# Optional: the public repository link shown on /judges, and the community-vote banner after a part verifies.
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_VOTE_URL=
# Optional: the MCP URL shown in the agent snippets (default: <site>/mcp, proxied to the API).
NEXT_PUBLIC_MCP_URL=
# Optional: origin of the API for the live-voice WebSocket when the web host cannot proxy WebSocket upgrades (Vercel).
# Keep the web origin in the API's PARTSMITH_CORS_ORIGINS. Empty = same origin.
NEXT_PUBLIC_VOICE_WS_ORIGIN=
