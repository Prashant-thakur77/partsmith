# PartSmith web app for the single-server deployment. Build from the repo root (compose.yml does this).
FROM node:22-slim
ENV NEXT_TELEMETRY_DISABLED=1 PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web apps/web
RUN pnpm install --frozen-lockfile --filter ./apps/web...
ARG SITE_URL
ARG REPO_URL=
ENV API_URL=http://api:8000 NEXT_PUBLIC_SITE_URL=$SITE_URL NEXT_PUBLIC_REPO_URL=$REPO_URL
RUN pnpm -C apps/web exec next build && chown -R node:node /app
EXPOSE 3000
USER node
CMD ["pnpm", "-C", "apps/web", "exec", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
