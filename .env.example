# PartSmith runs with ZERO keys: any missing key switches that provider to deterministic mock mode
# (logged + shown on /status). Fill these in and run `make live` to switch to live models.

# live | mock | replay  (unset = live where a key exists, mock otherwise)
PROVIDER_MODE=
# 1 = record every live call under $PARTSMITH_HOME/recordings (for replay mode)
PROVIDER_RECORD=
# 1 = route every stage to open-weight models (Spark Open, Glimmer, SAM 3 on Modal)
OPEN_WEIGHTS_ONLY=
# 1 = return a labelled mock instead of raising when every live provider fails
PROVIDER_FALLBACK_TO_MOCK=
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT_S=180
# Daily USD cap for live model calls (UTC day; unset/0 = no cap). Set it on any public deployment.
PARTSMITH_DAILY_USD_CAP=

# Meta Model API (Muse Spark 1.3, Muse Wonder, Muse Image, Muse Voice Transcribe, SAM 3.1) — https://dev.meta.ai
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Muse Code CLI reads this name (same value as MODEL_API_KEY)
META_API_KEY=

# Muse Spark Open (open weights) — Baseten first, then Fireworks / Together as fallbacks
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional override; by default the id comes from Baseten models.list() (guide: meta-models/muse-spark-open-1026)
SPARK_OPEN_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
TOGETHER_API_KEY=
TOGETHER_BASE_URL=

# Modal (self-hosted Muse Glimmer 30B + SAM 3 open weights). `modal token new` writes ~/.modal.toml instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# URLs printed by `modal deploy infra/modal/glimmer.py` and `modal deploy infra/modal/sam3.py`
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
SAM3_OPEN_URL=
SAM3_OPEN_API_KEY=
# Hugging Face read token (gated facebook/sam3 + facebook/sam3.1 checkpoints) — used inside the Modal image
HF_TOKEN=

# Storage (defaults: SQLite + local disk under PARTSMITH_HOME)
PARTSMITH_HOME=./var
DATABASE_URL=
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=partsmith

# 0 = skip the search-grounded "buy the original" lookup (the print side is still computed); benches always set 0
PARTSMITH_BUY_LOOKUP=

# Admin routes (factory approvals, lessons, print-shop batches). Empty = open, for local dev only; set it before deploying.
PARTSMITH_ADMIN_TOKEN=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Community-vote page shown after a part verifies (empty = no banner)
NEXT_PUBLIC_VOTE_URL=
