# PartSmith runs with ZERO keys: any missing key switches that provider to deterministic mock mode
# (logged + shown on /status). Fill these in and run `make live` to switch to live models.

# live | mock | replay  (unset = live where a key exists, mock otherwise)
PROVIDER_MODE=

# Meta Model API (Muse Spark 1.3, Muse Wonder, Muse Image, Muse Voice Transcribe, SAM 3.1) — https://dev.meta.ai
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Muse Code CLI reads this name (same value as MODEL_API_KEY)
META_API_KEY=

# Muse Spark Open (open weights) — Baseten first, then Fireworks / Together as fallbacks
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
FIREWORKS_API_KEY=
TOGETHER_API_KEY=

# Modal (self-hosted Muse Glimmer 30B + SAM 3 open weights). `modal token new` writes ~/.modal.toml instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# URLs printed by `modal deploy infra/modal/glimmer.py` and `modal deploy infra/modal/sam3.py`
GLIMMER_BASE_URL=
SAM3_OPEN_URL=
# Hugging Face read token (gated facebook/sam3 + facebook/sam3.1 checkpoints) — used inside the Modal image
HF_TOKEN=

# Storage (defaults: SQLite + local disk under PARTSMITH_HOME)
PARTSMITH_HOME=./var
DATABASE_URL=
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=partsmith

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
