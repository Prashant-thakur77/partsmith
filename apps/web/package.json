    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
